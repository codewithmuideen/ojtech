// Prisma schema for OJTech.
//
// SCAFFOLD ONLY: this schema is written and structurally complete, but is
// not migrated against a live database in this pass (no DATABASE_URL was
// provided). Once a Postgres connection string is available, run:
//   npx prisma migrate dev --name init
//
// Design notes:
// - "Service enquiries" and "Project enquiries" (spec §3) are represented as
//   ContactEnquiry.type rather than separate near-identical tables, to avoid
//   duplicating the same shape three times.
// - "User roles" (spec §3) is modeled as an enum on AdminUser rather than a
//   separate roles table, since no dynamic/custom-role requirement exists yet.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Admin & Auth ----------

enum AdminRole {
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ---------- Enquiries & Leads ----------

enum EnquiryType {
  GENERAL
  SERVICE
  PROJECT
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model ContactEnquiry {
  id        String        @id @default(cuid())
  type      EnquiryType   @default(GENERAL)
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  budget    String?
  timeline  String?
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model QuoteRequest {
  id           String        @id @default(cuid())
  fullName     String
  role         String?
  company      String
  industry     String?
  website      String?
  projectType  String
  requirements String
  budget       String
  timeline     String
  email        String
  phone        String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  @@index([status])
  @@index([createdAt])
}

model ConsultationRequest {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String?
  company       String?
  topic         String
  preferredDate String
  preferredTime String
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdAt     DateTime      @default(now())

  @@index([status])
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

// ---------- Content: Blog / Insights ----------

model BlogCategory {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogTag {
  id    String     @id @default(cuid())
  name  String
  slug  String     @unique
  posts BlogPost[]
}

model BlogPost {
  id                 String       @id @default(cuid())
  title              String
  slug               String       @unique
  excerpt            String
  content            String
  coverImage         String?
  readingTimeMinutes Int          @default(5)
  published          Boolean      @default(false)
  publishedAt        DateTime?
  category           BlogCategory @relation(fields: [categoryId], references: [id])
  categoryId         String
  tags               BlogTag[]
  author             TeamMember?  @relation(fields: [authorId], references: [id])
  authorId           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([published, publishedAt])
}

// ---------- Content: Case Studies & Projects ----------

model CaseStudy {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  client         String
  industry       String
  summary        String
  overview       String
  challenge      String
  objectives     String[]
  research       String
  strategy       String
  design         String
  development    String
  technologies   String[]
  implementation String
  results        String[]
  lessonsLearned String
  isPlaceholder  Boolean  @default(false)
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  client            String
  industry          String
  summary           String
  challenge         String
  solution          String
  result            String
  servicesDelivered String[]
  technologies      String[]
  isPlaceholder     Boolean  @default(false)
  published         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------- Content: People & Trust ----------

model Testimonial {
  quote     String
  author    String
  role      String
  company   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  id        String   @id @default(cuid())
}

model TeamMember {
  id        String     @id @default(cuid())
  name      String
  role      String
  bio       String?
  photo     String?
  order     Int        @default(0)
  published Boolean    @default(true)
  posts     BlogPost[]
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String  @default("General")
  order     Int     @default(0)
  published Boolean @default(true)
}

// ---------- Careers ----------

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ApplicationStatus {
  RECEIVED
  IN_REVIEW
  SHORTLISTED
  REJECTED
  HIRED
}

model JobOpening {
  id           String           @id @default(cuid())
  title        String
  slug         String           @unique
  department   String
  location     String
  type         JobType          @default(FULL_TIME)
  description  String
  published    Boolean          @default(true)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id           String            @id @default(cuid())
  jobOpening   JobOpening        @relation(fields: [jobOpeningId], references: [id])
  jobOpeningId String
  name         String
  email        String
  phone        String?
  resumeUrl    String
  coverLetter  String?
  status       ApplicationStatus @default(RECEIVED)
  createdAt    DateTime          @default(now())

  @@index([status])
}

// ---------- Training ----------

model TrainingCourse {
  id            String                 @id @default(cuid())
  title         String
  slug          String                 @unique
  description   String
  category      String
  durationWeeks Int
  price         Decimal?               @db.Decimal(10, 2)
  published     Boolean                @default(true)
  createdAt     DateTime               @default(now())
  registrations TrainingRegistration[]
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model TrainingRegistration {
  id               String             @id @default(cuid())
  trainingCourse   TrainingCourse     @relation(fields: [trainingCourseId], references: [id])
  trainingCourseId String
  name             String
  email            String
  phone            String?
  status           RegistrationStatus @default(PENDING)
  createdAt        DateTime           @default(now())

  @@index([status])
}

// ---------- Events, Partners, Technologies, Media, Settings ----------

model Event {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String
  startDate   DateTime
  endDate     DateTime?
  location    String?
  isVirtual   Boolean   @default(false)
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Partner {
  id        String  @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  order     Int     @default(0)
  published Boolean @default(true)
}

model Technology {
  id       String  @id @default(cuid())
  name     String
  category String
  iconUrl  String?
  order    Int     @default(0)
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model MediaAsset {
  id         String    @id @default(cuid())
  url        String
  alt        String?
  type       MediaType @default(IMAGE)
  uploadedAt DateTime  @default(now())
}

model WebsiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
