# Copy this file to .env and fill in real values.
# Nothing in this file is a secret — it documents what the app expects.

# --- Database (Prisma / Postgres) ---
# Neon (https://neon.tech) or Supabase (https://supabase.com) both work well
# on Vercel's serverless runtime. Locally, any Postgres instance works.
# If your password contains special characters (e.g. `#`), URL-encode them
# (`#` -> `%23`) or the connection string will fail to parse.
DATABASE_URL="postgresql://user:password@host:5432/ojtech?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/ojtech?sslmode=require"

# --- Email (Resend) ---
# https://resend.com — used for contact/quote/consultation notifications
# and newsletter confirmations. Templates live in emails/.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Until a sending domain is verified in Resend, you can only send FROM
# onboarding@resend.dev, and only TO the email address the Resend account
# was created with — see https://resend.com/docs/dashboard/domains/introduction
RESEND_FROM_EMAIL="OJTech <onboarding@resend.dev>"
RESEND_ADMIN_EMAIL="codewitmui@gmail.com"

# --- Site URLs ---
NEXT_PUBLIC_SITE_URL="https://www.ojtech.com"
NEXT_PUBLIC_APP_URL="https://www.ojtech.com"

# --- Auth (for the future /admin dashboard) ---
AUTH_SECRET=""

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=""
