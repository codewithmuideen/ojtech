# Copy this file to .env and fill in real values.
# This is a static export (output: "export") — there is no server at runtime,
# so these are read once at `npm run build` time and baked into the output.

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=""

# --- SEO ---
# Google Search Console -> Settings -> Ownership verification -> HTML tag ->
# just the content="..." value, not the whole tag.
GOOGLE_SITE_VERIFICATION=""
